---
import fullLogo from "../../assets/full-logo.svg";
import fullLogoWhite from "../../assets/full-logo-white.svg";
import closeIcon from "../../assets/close-icon.svg";
import hamburgerIcon from "../../assets/hamburger.svg";
import Button from "../atoms/Button.astro";
import LanguageToggle from "../atoms/LanguageToggle.astro";

const { button, links = [], openAlt, closeAlt, logoAlt, lang = "nl" } = Astro.props;
---

<header class="header visible" data-header>
    <div class="nav-bar">
        <a class="logo-link" href={lang === "nl" ? "/" : `/${lang}/`}>
            <picture>
                <source srcset={fullLogoWhite.src} media="(prefers-color-scheme: dark)" />
                <img
                    src={fullLogo.src}
                    alt={logoAlt}
                    width="100"
                    height="70"
                    fetchpriority="high"
                />
            </picture>
        </a>

        <div class="mobile-nav">
            <Button href="mailto:frank.kloos@fonetic.studio" classes="nav" content={button} />
            <button command="show-modal" commandfor="mobile-dialog" class="hamburger" type="button">
                <img src={hamburgerIcon.src} alt={openAlt} width="50" height="50" />
            </button>
        </div>

        <dialog class="mobile-dialog" id="mobile-dialog">
            <div class="mobile-menu-top">
                <button
                    type="button"
                    class="close-button"
                    commandfor="mobile-dialog"
                    command="close"
                    autofocus
                >
                    <img src={closeIcon.src} alt={closeAlt} width="25" height="25" />
                </button>
            </div>

            <nav class="links-nav">
                {/* Loops through all links, like {#each} in Svelte, but using JavaScript .map() */}
                {links.map((link) => (
                    <a href={link.href} class="nav-link">
                        {link.content}
                        <div class="underline-deco"></div>
                    </a>
                ))}

                <LanguageToggle lang={lang} />

                <Button href="mailto:frank.kloos@fonetic.studio" classes="nav" content={button} />
            </nav>
        </dialog>

        <nav class="desktop-nav">
            
            {links.map((link) => (
                <a href={link.href} class="nav-link">
                    {link.content}
                    <div class="underline-deco"></div>
                </a>
            ))}

            <LanguageToggle lang={lang} />

            <Button href="mailto:frank.kloos@fonetic.studio" classes="nav" content={button} />
        </nav>
    </div>
</header>

<script>
    const header = document.querySelector("[data-header]");
    const dialog = document.querySelector("#mobile-dialog");

    if (header) {
        let lastScrollY = window.scrollY;
        let ticking = false;

        window.addEventListener(
            "scroll",
            () => {
                if (ticking) return;
                ticking = true;

                requestAnimationFrame(() => {
                    const currentScrollY = window.scrollY;

                    if (currentScrollY <= 0) {
                        header.classList.add("visible");
                    } else if (currentScrollY > lastScrollY) {
                        header.classList.remove("visible");
                    } else if (currentScrollY < lastScrollY) {
                        header.classList.add("visible");
                    }

                    lastScrollY = currentScrollY;
                    ticking = false;
                });
            },
            { passive: true }
        );
    }

    if (dialog instanceof HTMLDialogElement) {
        dialog.querySelectorAll(".nav-link").forEach((link) => {
            link.addEventListener("click", () => dialog.close());
        });

        dialog.addEventListener("keydown", (event) => {
            if (event.key !== "Tab" || !dialog.open) return;

            const focusbaar = [
                ...dialog.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
            ].filter((el) => el.getClientRects().length > 0);

            const eerste = focusbaar[0];
            const laatste = focusbaar.at(-1);

            if (event.shiftKey && document.activeElement === eerste) {
                event.preventDefault();
                laatste?.focus();
            }

            if (!event.shiftKey && document.activeElement === laatste) {
                event.preventDefault();
                eerste?.focus();
            }
        });
    }
</script>

<style>
    .header {
        width: 100%;
        background-color: var(--background-color-primary);
        position: sticky;
        top: 0;
        left: 0;
        z-index: 10;

        .nav-link {
            text-decoration: none;
            color: var(--color-text-primary);
            transition: 0.1s ease-in-out;
        }
    }

    .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .mobile-nav {
        display: flex;
        place-items: center;
    }

    .hamburger img,
    .close-button img {
        @media (prefers-color-scheme: dark) {
            filter: brightness(0) invert(1);
        }
    }

    .mobile-dialog {
        margin: 0;
        border: none;
        width: 100%;
        height: 100%;
        max-width: none;
        max-height: none;
        padding: 30px;
        background-color: var(--background-color-primary);
        color: var(--color-text-primary);
    }

    .mobile-dialog[open] {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
    }

    .links-nav {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 30px;
    }

    .nav-link {
        transition: 0.1s ease-in-out;

        .underline-deco {
            width: 0%;
            height: 1px;
            background-color: var(--text-color-primary);
            transition: all 0.3s ease;
        }

        &:hover {
            text-decoration: underline;
            scale: 1.02;

            @media (prefers-reduced-motion: no-preference) {
                text-decoration: unset;

                .underline-deco {
                    width: 100%;
                    transition: all 0.3s ease;
                }
            }
        }

        &:focus-visible {
            outline-offset: 6px;
            outline: 2px solid var(--text-color-primary);
            border-radius: 5px;
        }
    }

    .desktop-nav {
        display: none;
    }

    .mobile-menu-top {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: start;
        width: 100%;
    }

    .close-button {
        grid-column: 3;
        justify-self: end;
    }

    @media (width >= 1024px) {
        .logo-link img {
            width: 176px;
            height: 80px;
        }

        .mobile-nav {
            display: none;
        }

        .desktop-nav {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: end;
            gap: 24px;
            padding: 20px;
            width: 100%;
        }

        .header {
            position: fixed;
            right: 0;
            transform: translateY(-100%);

            @media (prefers-reduced-motion: no-preference) {
                transition: all 0.5s ease;
            }
        }

        .visible {
            transform: translateY(0);
        }
    }
</style>