---
import "../styles/global.css";
import Nav from "../components/organisms/Nav.astro";
import { content as allContent } from "../lib/content.js";

const { title = "Prologg", lang = "nl" } = Astro.props;

const content = allContent[lang];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
    </head>
    <body>
        <Nav {...content.navigation} lang={lang} />

        <main>
            <slot />
        </main>
    </body>
</html>